# EditorConfig: hace que cualquier editor (VS Code, WebStorm...) use el mismo formato básico.
# https://editorconfig.org
root = true

[*]
charset = utf-8
# Saltos de línea estilo Unix, aunque trabajes en Windows (evita diffs "fantasma" en git).
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# En Markdown dos espacios al final de línea significan salto de línea: no los borramos.
trim_trailing_whitespace = false
